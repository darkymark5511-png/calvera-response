# Supabase Postgres — transaction pooler (port 6543), used by the running app on Vercel
DATABASE_URL=

# Supabase Postgres — session pooler (port 5432 on the pooler host), used by drizzle-kit from a developer machine or CI
DATABASE_URL_MIGRATE=

# Admin seed (scripts/seed-admin.ts) — never commit real values
ADMIN_USERNAME=
ADMIN_PASSWORD=
